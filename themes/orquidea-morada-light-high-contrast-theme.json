	  "gitDecoration.modifiedResourceForeground": "#8E5BFF",
	  "gitDecoration.deletedResourceForeground": "#DC3545",
	  "gitDecoration.renamedResourceForeground": "#17A2B8",
	  "gitDecoration.untrackedResourceForeground": "#28A745",
  
	  "diffEditor.insertedTextBackground": "#19875420",
	  "diffEditor.removedTextBackground": "#DC354520",
	  "diffEditor.border": "#C49BFF",

	  "panel.border": "#10B981",

	  "sideBar.border": "#10B981",
	  "sideBarSectionHeader.border": "#10B981",

	  "editorGroup.border": "#10B981",
	  "editorGroupHeader.border": "#10B981",
	  "editorGroupHeader.tabsBorder": "#10B981",

	  "tab.activeBorderTop": "#8E5BFF",
	  "tab.activeBorder": "#8E5BFF",
	  "tab.border": "#E8E3FF",
	  "tab.lastPinnedBorder": "#10B981",

