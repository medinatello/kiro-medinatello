	  "terminal.ansiGreen": "#198754",
	  "terminal.ansiYellow": "#E67E22",
	  "terminal.ansiBlue": "#17A2B8",
	  "terminal.ansiMagenta": "#FF00FF",
	  "terminal.ansiCyan": "#17A2B8",
	  "terminal.ansiWhite": "#A9A9A9",
	  "terminal.ansiBrightBlack": "#6C757D",
	  "terminal.ansiBrightRed": "#FF5B71",
	  "terminal.ansiBrightGreen": "#28A745",
	  "terminal.ansiBrightYellow": "#FFC107",
	  "terminal.ansiBrightBlue": "#20C997",
	  "terminal.ansiBrightMagenta": "#FFB3FF",
	  "terminal.ansiBrightCyan": "#20C997",
	  "terminal.ansiBrightWhite": "#333333",
  
	  "gitDecoration.addedResourceForeground": "#198754",
	  "gitDecoration.modifiedResourceForeground": "#FF00FF",
	  "gitDecoration.deletedResourceForeground": "#DC3545",
	  "gitDecoration.renamedResourceForeground": "#17A2B8",
	  "gitDecoration.untrackedResourceForeground": "#28A745",
  
	  "diffEditor.insertedTextBackground": "#19875420",
	  "diffEditor.removedTextBackground": "#DC354520",
	  "diffEditor.border": "#FF00FF",

	  "panel.border": "#FF00FF",

	  "sideBar.border": "#FF00FF",
	  "sideBarSectionHeader.border": "#FF00FF",

	  "editorGroup.border": "#FF00FF",
	  "editorGroupHeader.border": "#FF00FF",
	  "editorGroupHeader.tabsBorder": "#FF00FF",

	  "tab.activeBorderTop": "#FF00FF",
	  "tab.activeBorder": "#FF00FF",
	  "tab.border": "#E6F5EB",
	  "tab.lastPinnedBorder": "#FF00FF",

	  "statusBar.border": "#FF00FF",
	  "statusBar.focusBorder": "#FF00FF",
	  "statusBarItem.focusBorder": "#FF00FF",

	  "panelTitle.activeBorder": "#FF00FF",
	  "panelTitle.activeForeground": "#FF00FF",
	  "panelTitle.inactiveForeground": "#A9A9A9",
	  "panelSection.border": "#FF00FF",
	  "panelSectionHeader.border": "#FF00FF"
	},
  
	"tokenColors": [
	  { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6A737D", "fontStyle": "italic" } },
	  { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#FF00FF", "fontStyle": "bold" } },
	  { "scope": ["entity.name.type", "support.type", "support.class", "support.type.primitive"], "settings": { "foreground": "#17A2B8" } },
	  { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#198754" } },
	  { "scope": ["variable", "meta.definition.variable", "meta.object-literal.key"], "settings": { "foreground": "#333333" } },
	  { "scope": ["string", "constant.character.escape"], "settings": { "foreground": "#D97706" } },
	  { "scope": ["constant.numeric", "constant.language", "constant.other"], "settings": { "foreground": "#E85D75" } },
	  { "scope": ["punctuation", "delimiter", "meta.brace"], "settings": { "foreground": "#333333" } },
	  { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#DC3545", "fontStyle": "bold underline" } }
	],
  
	"semanticTokenColors": {
	  "namespace": "#17A2B8",
	  "type": "#17A2B8",
	  "class": "#17A2B8",
	  "struct": "#17A2B8",
	  "enum": "#E67E22",
	  "interface": "#198754",
	  "typeParameter": "#198754",
  
	  "function": "#198754",
	  "method": "#198754",
	  "macro": "#FF00FF",
	  "property": "#333333",
	  "variable": "#333333",
	  "parameter": "#333333",
  
	  "string": "#D97706",
	  "number": "#E85D75",
	  "boolean": "#E85D75",
	  "regexp": "#D97706",
  
	  "comment": "#6A737D",
	  "operator": "#333333",
	  "event": "#FF00FF",
  
	  "deprecated": { "foreground": "#A9A9A9", "strikethrough": true },
	  "readonly": "#17A2B8",
	  "static": "#FF00FF"
	}
  }
