	  "terminal.ansiWhite": "#666666",
	  "terminal.ansiBrightBlack": "#999999",
	  "terminal.ansiBrightRed": "#FF5B71",
	  "terminal.ansiBrightGreen": "#28A745",
	  "terminal.ansiBrightYellow": "#FFC107",
	  "terminal.ansiBrightBlue": "#20C997",
	  "terminal.ansiBrightMagenta": "#BBA8FF",
