{
	"name": "orquidea-morada-dark-high-contrast",
	"$schema": "vscode://schemas/color-theme",
	"type": "dark",
	"semanticHighlighting": true,
	"colors": {
		"editor.background": "#000000",
		"editor.foreground": "#FFFFFF",
		"focusBorder": "#B366FF",
		"selection.background": "#3C2A6748",
		"contrastActiveBorder": "#B366FF",
		"editor.lineHighlightBackground": "#1A1722",
		"editor.selectionBackground": "#A47CFF44",
		"editor.inactiveSelectionBackground": "#3C2A6726",
		"editor.findMatchBackground": "#FFD08A33",
		"editor.findMatchHighlightBackground": "#FFD08A22",
		"editor.wordHighlightBackground": "#8D7CFF22",
		"editor.wordHighlightStrongBackground": "#8D7CFF33",
		"editor.hoverHighlightBackground": "#3C2A6722",
		"editorLink.activeForeground": "#BBA8FF",
		"editorCursor.foreground": "#BF7CFF",
		"editorIndentGuide.background1": "#2A2436",
		"editorIndentGuide.activeBackground1": "#4B3A73",
		"editorIndentGuide.background2": "#272135",
		"editorIndentGuide.activeBackground2": "#463669",
		"editorLineNumber.foreground": "#5B5173",
		"editorLineNumber.activeForeground": "#BBA8FF",
		"editorGutter.addedBackground": "#5CE3B9AA",
		"editorGutter.modifiedBackground": "#8D7CFFAA",
		"editorGutter.deletedBackground": "#FF9BB6AA",
		"editorBracketHighlight.foreground1": "#B6E3A8",
		"editorBracketHighlight.foreground2": "#9AD6FF",
		"editorBracketHighlight.foreground3": "#EFD080",
		"editorBracketHighlight.unexpectedBracket.foreground": "#FF778F",
		"editorError.foreground": "#FF778F",
		"editorWarning.foreground": "#EFD080",
		"editorInfo.foreground": "#9AD6FF",
		"minimap.selectionHighlight": "#3C2A6780",
		"minimap.findMatchHighlight": "#FFD08A80",
		"minimap.background": "#000000",
		"editorWidget.background": "#000000",
		"editorWidget.foreground": "#E9E7F1",
		"editorWidget.border": "#2B2142",
		"editorSuggestWidget.background": "#000000",
		"editorSuggestWidget.border": "#2B2142",
		"editorSuggestWidget.selectedBackground": "#2D214B",
		"list.activeSelectionBackground": "#2D214B",
		"list.activeSelectionForeground": "#F2ECFF",
		"list.focusBackground": "#241B3A",
		"list.focusForeground": "#F2ECFF",
		"list.hoverBackground": "#1A1526",
		"list.hoverForeground": "#E9E7F1",
		"list.inactiveSelectionBackground": "#221B33",
		"list.highlightForeground": "#FFD08A",
		"sideBar.background": "#000000",
		"sideBar.foreground": "#CFC9E6",
		"sideBarSectionHeader.background": "#000000",
		"activityBar.background": "#000000",
		"activityBar.foreground": "#D6C8FF",
		"activityBar.border": "#2B2142",
		"activityBarBadge.background": "#8E5BFF",
		"activityBarBadge.foreground": "#FFFFFF",
		"titleBar.activeBackground": "#000000",
		"titleBar.activeForeground": "#DAD3F0",
		"titleBar.inactiveBackground": "#000000",
		"titleBar.inactiveForeground": "#B9AFDA",
		"tab.activeBackground": "#000000",
		"tab.activeForeground": "#F2ECFF",
		"tab.inactiveBackground": "#000000",
		"tab.inactiveForeground": "#B9AFDA",
		"tab.hoverBackground": "#1B1630",
		"panel.background": "#000000",
		"statusBar.background": "#000000",
		"statusBar.foreground": "#CFC9E6",
		"statusBar.noFolderBackground": "#000000",
		"statusBar.debuggingBackground": "#7C55F6",
		"statusBar.debuggingForeground": "#FFFFFF",
		"button.background": "#7C55F6",
		"button.foreground": "#FFFFFF",
		"button.hoverBackground": "#8E5BFF",
		"badge.background": "#5F47D8",
		"badge.foreground": "#EFEAFF",
		"input.background": "#000000",
		"input.foreground": "#E9E7F1",
		"input.border": "#2B2142",
		"dropdown.background": "#000000",
		"dropdown.border": "#2B2142",
		"peekView.border": "#8E5BFF",
		"peekViewTitle.background": "#000000",
		"peekViewEditor.background": "#000000",
		"quickInput.background": "#000000",
		"notificationCenterHeader.background": "#000000",
		"notificationToast.border": "#8E5BFF",
		"scrollbarSlider.background": "#6B648044",
		"scrollbarSlider.hoverBackground": "#6B648066",
		"scrollbarSlider.activeBackground": "#6B648088",
		"terminal.background": "#000000",
		"terminal.foreground": "#FFFFFF",
		"panel.border": "#B366FF",
		"sideBar.border": "#B366FF",
		"tab.activeBorderTop": "#B366FF",
		"statusBar.border": "#B366FF"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#9E9E9E" } },
		{ "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#FFD700", "fontStyle": "bold" } },
		{ "scope": ["entity.name.type", "support.type", "support.class", "support.type.primitive"], "settings": { "foreground": "#7FFF00" } },
		{ "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#FF55A8" } },
		{ "scope": ["variable", "meta.definition.variable", "meta.object-literal.key"], "settings": { "foreground": "#A8D8FF" } },
		{ "scope": ["string", "constant.character.escape"], "settings": { "foreground": "#2EE8D7" } },
		{ "scope": ["constant.numeric", "constant.language", "constant.other"], "settings": { "foreground": "#FF00FF" } },
		{ "scope": ["punctuation", "delimiter", "meta.brace"], "settings": { "foreground": "#F0F0F0" } },
		{ "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF778F", "fontStyle": "bold underline" } }
	]
}
