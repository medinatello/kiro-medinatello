	"tokenColors": [
	  { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#9D8DBF", "fontStyle": "italic" } },
	  { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#8E5BFF", "fontStyle": "bold" } },
	  { "scope": ["entity.name.type", "support.type", "support.class", "support.type.primitive"], "settings": { "foreground": "#17A2B8" } },
	  { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#198754" } },
	  { "scope": ["variable", "meta.definition.variable", "meta.object-literal.key"], "settings": { "foreground": "#5A4A6A" } },
	  { "scope": ["string", "constant.character.escape"], "settings": { "foreground": "#D97706" } },
	  { "scope": ["constant.numeric", "constant.language", "constant.other"], "settings": { "foreground": "#E85D75" } },
	  { "scope": ["punctuation", "delimiter", "meta.brace"], "settings": { "foreground": "#7D6B8F" } },
	  { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#DC3545", "fontStyle": "bold underline" } }
	],
  
	"semanticTokenColors": {
	  "namespace": "#17A2B8",
	  "type": "#17A2B8",
	  "class": "#17A2B8",
	  "struct": "#17A2B8",
	  "enum": "#E67E22",
	  "interface": "#198754",
	  "typeParameter": "#198754",
  
	  "function": "#198754",
	  "method": "#198754",
	  "macro": "#8E5BFF",
	  "property": "#5A4A6A",
	  "variable": "#5A4A6A",
	  "parameter": "#5A4A6A",
  
	  "string": "#D97706",
	  "number": "#E85D75",
	  "boolean": "#E85D75",
	  "regexp": "#D97706",
  
	  "comment": "#9D8DBF",
	  "operator": "#7D6B8F",
	  "event": "#7C55F6",
  
	  "deprecated": { "foreground": "#B9AFDA", "strikethrough": true },
	  "readonly": "#17A2B8",
	  "static": "#7C55F6"
	}
  }