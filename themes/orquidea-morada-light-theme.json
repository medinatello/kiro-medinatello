{
	"name": "orquidea-morada-light",
	"$schema": "vscode://schemas/color-theme",
	"type": "light",
	"semanticHighlighting": true,

	/* ========================================
	   PALETA DE COLORES (Referencia)
	   ========================================
	   ACTIVOS:   #8E5BFF (Morado principal)
	              #5F47D8 (Morado oscuro)
	              #7C55F6 (Morado medio)

	   INACTIVOS: #10B981 (Verde menta)
	              #34D399 (Verde medio)

	   FONDOS:    #FBF8F3 (Beige Lavanda - fondo principal)
	              #E8E3FF (Lavanda suave - highlights)
	              #D1FAE5 (Verde suave - selecciones inactivas)

	   ACENTO:    #17A2B8 (Cian-verdoso - info/tipos)
	              #20C997 (Cian brillante - elementos destacados)
	   ======================================== */

	"colors": {
	  /* Accento y bordes base - MORADO para activos */
	  "focusBorder": "#8E5BFF",  /* MORADO para foco general */
	  "selection.background": "#E8E3FF",  /* LAVANDA para selecciones */
	  "contrastActiveBorder": "#8E5BFF",
	  "contrastBorder": "#10B981",  /* VERDE para bordes generales */
  
	  /* Editor - MORADO para elementos activos */
	  "editor.background": "#FBF8F3",
	  "editor.foreground": "#2D1B3D",
	  "editor.lineHighlightBackground": "#F8F6FF",
	  "editor.lineHighlightBorder": "#E8E3FF",
	  "editor.selectionBackground": "#E8E3FF",  /* LAVANDA */
	  "editor.selectionHighlightBackground": "#E8E3FF80",
	  "editor.inactiveSelectionBackground": "#D1FAE5",  /* VERDE inactivo */
	  "editor.findMatchBackground": "#FFD08A55",
	  "editor.findMatchHighlightBackground": "#FFD08A33",
	  "editor.findMatchBorder": "#8E5BFF",  /* MORADO */
	  "editor.findRangeHighlightBorder": "#8E5BFF",
	  "editor.wordHighlightBackground": "#E8E3FF50",
	  "editor.wordHighlightStrongBackground": "#E8E3FF",
	  "editor.wordHighlightBorder": "#8E5BFF",
	  "editor.wordHighlightStrongBorder": "#5F47D8",
	  "editor.hoverHighlightBackground": "#E8E3FF50",
	  "editorLink.activeForeground": "#8E5BFF",  /* MORADO */
	  "editorCursor.foreground": "#8E5BFF",  /* Cursor MORADO */
	  "editorCursor.background": "#FBF8F3",
  
	  /* Indent guides - sutiles pero visibles */
	  "editorIndentGuide.background1": "#E8E3FF",
	  "editorIndentGuide.activeBackground1": "#C49BFF",
	  "editorIndentGuide.background2": "#EBE7FF",
	  "editorIndentGuide.activeBackground2": "#BBA8FF",
  
	  /* Gutter y line numbers */
	  "editorLineNumber.foreground": "#B9AFDA",
	  "editorLineNumber.activeForeground": "#7C55F6",
	  "editorGutter.addedBackground": "#28A745BB",
	  "editorGutter.modifiedBackground": "#8E5BFFBB",
	  "editorGutter.deletedBackground": "#DC3545BB",
  
	  /* Brackets y pares - colores vibrantes pero legibles */
	  "editorBracketHighlight.foreground1": "#198754",
	  "editorBracketHighlight.foreground2": "#17A2B8",  /* CIAN-VERDOSO en lugar de azul */
	  "editorBracketHighlight.foreground3": "#E67E22",
	  "editorBracketHighlight.unexpectedBracket.foreground": "#DC3545",
  
	  /* Markers de problemas */
	  "editorError.foreground": "#DC3545",
	  "editorWarning.foreground": "#E67E22",
	  "editorInfo.foreground": "#17A2B8",  /* CIAN-VERDOSO para info */
  
	  /* Minimap */
	  "minimap.selectionHighlight": "#8E5BFF40",
	  "minimap.findMatchHighlight": "#FFD08A80",
	  "minimap.background": "#FBF8F3",
  
	  /* Widgets del editor - MORADO para selección */
	  "editorWidget.background": "#FBF8F3",
	  "editorWidget.foreground": "#2D1B3D",
	  "editorWidget.border": "#10B981",
	  "editorWidget.resizeBorder": "#8E5BFF",  /* MORADO para resize */
	  "editorSuggestWidget.background": "#FBF8F3",
	  "editorSuggestWidget.border": "#10B981",
	  "editorSuggestWidget.selectedBackground": "#E8E3FF",  /* LAVANDA */
	  "editorSuggestWidget.selectedForeground": "#2D1B3D",
	  "editorSuggestWidget.focusHighlightForeground": "#8E5BFF",  /* MORADO */
	  "editorSuggestWidget.highlightForeground": "#8E5BFF",
  
	  /* Listas y árbol - MORADO para selección activa */
	  "list.activeSelectionBackground": "#E8E3FF",  /* LAVANDA */
	  "list.activeSelectionForeground": "#2D1B3D",
	  "list.focusBackground": "#E8E3FF",
	  "list.focusForeground": "#2D1B3D",
	  "list.focusOutline": "#8E5BFF",  /* MORADO para foco */
	  "list.hoverBackground": "#F4F1FF",  /* LAVANDA hover */
	  "list.hoverForeground": "#2D1B3D",
	  "list.inactiveSelectionBackground": "#D1FAE5",  /* VERDE inactivo */
	  "list.highlightForeground": "#8E5BFF",  /* MORADO para highlights */
	  "list.inactiveFocusOutline": "#10B981",  /* VERDE para inactivos */
  
	  /* Activity bar / Side bar / Title bar */
	  "sideBar.background": "#FBF8F3",
	  "sideBar.foreground": "#4B3A73",
	  "sideBarSectionHeader.background": "#F0EDFF",

	  /* Activity Bar - MORADO con inactivos VERDES */
	  "activityBar.background": "#FBF8F3",

	  /* Botón ACTIVO - MORADO brillante */
	  "activityBar.foreground": "#8E5BFF",  /* MORADO para activos */
	  "activityBar.border": "#10B981",  /* VERDE borde */
	  "activityBar.activeBorder": "#8E5BFF",  /* MORADO */
	  "activityBar.activeBackground": "#E8E3FF",  /* LAVANDA suave */
	  "activityBar.activeFocusBorder": "#5F47D8",

	  /* Botones INACTIVOS - VERDE visible */
	  "activityBar.inactiveForeground": "#10B981",  /* VERDE para inactivos */

	  "activityBarBadge.background": "#8E5BFF",
	  "activityBarBadge.foreground": "#FFFFFF",
  
	  "titleBar.activeBackground": "#F5F3FF",
	  "titleBar.activeForeground": "#2D1B3D",
	  "titleBar.inactiveBackground": "#F5F3FF",
	  "titleBar.inactiveForeground": "#6B6480",
  
	  /* Tabs y grupos de editor - MORADO para tabs activos */
	  "tab.activeBackground": "#FBF8F3",
	  "tab.activeForeground": "#8E5BFF",  /* MORADO para texto activo */
	  "tab.inactiveBackground": "#F5F3FF",
	  "tab.inactiveForeground": "#10B981",  /* VERDE para inactivos */
	  "tab.hoverBackground": "#F4F1FF",  /* LAVANDA hover */
	  "tab.hoverBorder": "#8E5BFF",  /* MORADO al pasar el mouse */
	  "tab.unfocusedHoverBorder": "#10B981",  /* VERDE hover sin foco */
  
	  /* Paneles y barra de estado */
	  "panel.background": "#F5F3FF",

	  "statusBar.background": "#F5F3FF",
	  "statusBar.foreground": "#4B3A73",
	  "statusBar.noFolderBackground": "#F0EDFF",
	  "statusBar.debuggingBackground": "#8E5BFF",
	  "statusBar.debuggingForeground": "#FFFFFF",
  
	  /* Botones - MORADO para primarios, verde para secundarios */
	  "button.background": "#8E5BFF",  /* MORADO para botón principal */
	  "button.foreground": "#FFFFFF",
	  "button.hoverBackground": "#7C55F6",  /* MORADO más oscuro hover */
	  "button.border": "#8E5BFF",
	  "button.secondaryBackground": "#D1FAE5",  /* VERDE suave secundario */
	  "button.secondaryForeground": "#10B981",  /* Texto VERDE */
	  "button.secondaryHoverBackground": "#A7F3D0",
	  "button.secondaryBorder": "#10B981",

	  "badge.background": "#8E5BFF",  /* MORADO */
	  "badge.foreground": "#FFFFFF",

	  /* Inputs - MORADO para activo, verde para borde general */
	  "input.background": "#FBF8F3",
	  "input.foreground": "#2D1B3D",
	  "input.border": "#10B981",  /* VERDE para borde normal */
	  "inputOption.activeBorder": "#8E5BFF",  /* MORADO para opciones activas */
	  "inputOption.activeBackground": "#E8E3FF",  /* LAVANDA */
	  "inputOption.activeForeground": "#2D1B3D",
	  "dropdown.background": "#FBF8F3",
	  "dropdown.border": "#10B981",
  
	  /* Peek, Quick input, Notificaciones - MORADO para selección */
	  "peekView.border": "#10B981",
	  "peekViewTitle.background": "#F0EDFF",
	  "peekViewEditor.background": "#FBF8F3",
	  "peekViewEditorGutter.background": "#F5F3FF",
	  "peekViewResult.background": "#FBF8F3",
	  "peekViewResult.selectionBackground": "#E8E3FF",  /* LAVANDA */
	  "peekViewResult.selectionForeground": "#2D1B3D",
	  "peekViewResult.matchHighlightBackground": "#D6CEFF",  /* LAVANDA más clara */
	  "quickInput.background": "#FBF8F3",
	  "quickInput.foreground": "#2D1B3D",
	  "quickInputList.focusBackground": "#E8E3FF",  /* LAVANDA */
	  "quickInputList.focusForeground": "#2D1B3D",
	  "quickInputList.focusIconForeground": "#8E5BFF",  /* MORADO */
	  "notificationCenterHeader.background": "#F5F3FF",
	  "notificationToast.border": "#10B981",
	  "notifications.border": "#10B981",
	  "notificationLink.foreground": "#8E5BFF",  /* MORADO para links */
  
	  /* Scrollbars discretos pero visibles */
	  "scrollbarSlider.background": "#D6C8FF55",
	  "scrollbarSlider.hoverBackground": "#D6C8FF77",
	  "scrollbarSlider.activeBackground": "#C49BFF99",
  
	  /* Terminal - mantiene legibilidad en fondo claro */
	  "terminal.background": "#FBF8F3",
	  "terminal.foreground": "#2D1B3D",
	  "terminalCursor.foreground": "#8E5BFF",
  
	  "terminal.ansiBlack": "#2D1B3D",
	  "terminal.ansiRed": "#DC3545",
	  "terminal.ansiGreen": "#198754",
	  "terminal.ansiYellow": "#E67E22",
	  "terminal.ansiBlue": "#17A2B8",  /* CIAN-VERDOSO armonioso */
	  "terminal.ansiMagenta": "#8E5BFF",
	  "terminal.ansiCyan": "#17A2B8",
	  "terminal.ansiWhite": "#495057",
	  "terminal.ansiBrightBlack": "#6C757D",
	  "terminal.ansiBrightRed": "#FF5B71",
	  "terminal.ansiBrightGreen": "#28A745",
	  "terminal.ansiBrightYellow": "#FFC107",
	  "terminal.ansiBrightBlue": "#20C997",  /* CIAN brillante armonioso */
	  "terminal.ansiBrightMagenta": "#BBA8FF",
	  "terminal.ansiBrightCyan": "#20C997",
	  "terminal.ansiBrightWhite": "#343A40",
  
	  /* Git y Diff */
	  "gitDecoration.addedResourceForeground": "#198754",
	  "gitDecoration.modifiedResourceForeground": "#8E5BFF",
	  "gitDecoration.deletedResourceForeground": "#DC3545",
	  "gitDecoration.renamedResourceForeground": "#17A2B8",
	  "gitDecoration.untrackedResourceForeground": "#28A745",
  
	  "diffEditor.insertedTextBackground": "#19875420",
	  "diffEditor.removedTextBackground": "#DC354520",
	  "diffEditor.border": "#C49BFF",

	  "panel.border": "#10B981",

	  /* Sidebar con bordes VERDES */
	  "sideBar.border": "#10B981",
	  "sideBarSectionHeader.border": "#10B981",

	  /* Editor group (entre splits) - bordes VERDES */
	  "editorGroup.border": "#10B981",
	  "editorGroupHeader.border": "#10B981",
	  "editorGroupHeader.tabsBorder": "#10B981",

	  /* Tabs con bordes MORADOS para activos */
	  "tab.activeBorderTop": "#8E5BFF",  /* MORADO para tab activo */
	  "tab.activeBorder": "#8E5BFF",
	  "tab.border": "#E8E3FF",
	  "tab.lastPinnedBorder": "#10B981",

	  /* Status bar con bordes MORADOS para foco */
	  "statusBar.border": "#10B981",
	  "statusBar.focusBorder": "#8E5BFF",  /* MORADO para foco */
	  "statusBarItem.focusBorder": "#8E5BFF",

	  /* Panel con bordes MORADOS para activos */
	  "panelTitle.activeBorder": "#8E5BFF",  /* MORADO para panel activo */
	  "panelTitle.activeForeground": "#8E5BFF",
	  "panelTitle.inactiveForeground": "#10B981",  /* VERDE para inactivos */
	  "panelSection.border": "#10B981",
	  "panelSectionHeader.border": "#10B981"
	},
  
	"tokenColors": [
	  { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#9D8DBF", "fontStyle": "italic" } },
	  { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#8E5BFF", "fontStyle": "bold" } },
	  { "scope": ["entity.name.type", "support.type", "support.class", "support.type.primitive"], "settings": { "foreground": "#17A2B8" } },
	  { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#198754" } },
	  { "scope": ["variable", "meta.definition.variable", "meta.object-literal.key"], "settings": { "foreground": "#5A4A6A" } },
	  { "scope": ["string", "constant.character.escape"], "settings": { "foreground": "#D97706" } },
	  { "scope": ["constant.numeric", "constant.language", "constant.other"], "settings": { "foreground": "#E85D75" } },
	  { "scope": ["punctuation", "delimiter", "meta.brace"], "settings": { "foreground": "#7D6B8F" } },
	  { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#DC3545", "fontStyle": "bold underline" } }
	],
  
	"semanticTokenColors": {
	  "namespace": "#17A2B8",
	  "type": "#17A2B8",
	  "class": "#17A2B8",
	  "struct": "#17A2B8",
	  "enum": "#E67E22",
	  "interface": "#198754",
	  "typeParameter": "#198754",
  
	  "function": "#198754",
	  "method": "#198754",
	  "macro": "#8E5BFF",
	  "property": "#5A4A6A",
	  "variable": "#5A4A6A",
	  "parameter": "#5A4A6A",
  
	  "string": "#D97706",
	  "number": "#E85D75",
	  "boolean": "#E85D75",
	  "regexp": "#D97706",
  
	  "comment": "#9D8DBF",
	  "operator": "#7D6B8F",
	  "event": "#7C55F6",
  
	  "deprecated": { "foreground": "#B9AFDA", "strikethrough": true },
	  "readonly": "#17A2B8",
	  "static": "#7C55F6"
	}
  }
