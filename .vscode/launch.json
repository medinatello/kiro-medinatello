// Configuración para probar extensión de tema
// Cambia manualmente el tema después de lanzar con Cmd+K Cmd+T
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Probar Extensión",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			]
		}
	]
}
